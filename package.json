    "benchmark:browser": "tsx scripts/benchmark-browser-payload.ts",
    "verify:vercel": "node scripts/verify-vercel-config.mjs && npm run typecheck:build",
    "verify:release": "npm run verify:static-limits && npm run verify:responsive && npm run verify:serverless && npm run verify:analysis-recovery && npm run typecheck && npm run test && npm run verify:phase3 && npm run verify:phase4 && npm run verify:phase5 && npm run verify:phase6 && npm run verify:phase7 && npm run verify:phase8 && npm run verify:phase9 && npm run verify:medium-accuracy && npm run verify:report-signals && npm run benchmark:100k && npm run benchmark:browser && npm run build",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:phase5": "tsx scripts/verify-phase5.ts",
    "verify:phase6": "tsx scripts/verify-phase6.ts",
    "verify:phase7": "tsx scripts/verify-phase7.ts",
    "verify:report-signals": "tsx scripts/verify-report-signals.ts",
    "verify:responsive": "node scripts/verify-responsive.mjs",
    "verify:serverless": "node scripts/verify-serverless-runtime.mjs",
    "verify:analysis-recovery": "tsx scripts/verify-analysis-recovery.ts",
    "verify:medium-accuracy": "tsx scripts/verify-medium-accuracy.ts",
