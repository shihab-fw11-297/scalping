  },
  "dependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lightweight-charts": "5.2.0",
    "next": "16.2.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "vitest": "4.1.10"
  }
